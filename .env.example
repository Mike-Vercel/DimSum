# ─────────────────────────────────────────────────────────────────────────────
# DIMSUM — environment variables
# Copy to `.env` for local development. On Vercel set them in Project → Settings →
# Environment Variables. Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (e-mail links, OAuth callbacks, sitemap). Production: https://dimsum.it
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Local: `npm run dev` starts an embedded PostgreSQL 17 on port 54329 (no Docker).
# Production: a managed PostgreSQL (Neon, Vercel Postgres, Supabase…) with a pooled URL.
DATABASE_URL=postgresql://dimsum:dimsum@127.0.0.1:54329/dimsum
# Direct (non-pooled) connection used by migrations. Optional locally.
DIRECT_DATABASE_URL=
# Database for the end-to-end tests: its name must end in _test (the suite opens it 24/7 and adds orders).
TEST_DATABASE_URL=postgresql://dimsum:dimsum@127.0.0.1:54329/dimsum_test
# Connections per serverless instance.
DATABASE_POOL_MAX=5

# ── Authentication (Better Auth) ────────────────────────────────────────────
# At least 32 random characters: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
# Only if different from APP_URL.
BETTER_AUTH_URL=
# Google Sign-In (optional). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple (optional, ready for the iOS app). Redirect URI: {APP_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Payments ────────────────────────────────────────────────────────────────
# "stripe" in production. "dev" enables the local payment simulator (refused on Vercel production).
PAYMENT_PROVIDER=dev
STRIPE_SECRET_KEY=
# Webhook endpoint: {APP_URL}/api/webhooks/stripe — events: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.processing, payment_intent.canceled, refund.created, refund.updated
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Allows the simulator on a non-Vercel production-like environment (staging only).
ALLOW_DEV_PAYMENTS=

# ── Maps, geocoding and routing ─────────────────────────────────────────────
# "osm" (default, keyless: Photon + OSRM + OpenFreeMap tiles), "google" or "mapbox".
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
# Self-hosted alternatives for the keyless provider (recommended in production).
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# Contact e-mail sent to OpenStreetMap services (their usage policy asks for it).
GEO_CONTACT_EMAIL=
# MapLibre styles for the maps (light and dark).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark

# ── E-mail ──────────────────────────────────────────────────────────────────
# "brevo", "resend" or "smtp" in production; "outbox" stores e-mails in the database (development).
EMAIL_PROVIDER=outbox
# Sender: an address of a domain authenticated in the provider (SPF, DKIM, DMARC).
EMAIL_FROM=DIMSUM <ordini@dimsum.it>
EMAIL_REPLY_TO=
# Brevo → SMTP & API → API Keys (transactional e-mails, https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=
RESEND_API_KEY=
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=

# ── File storage (product photos uploaded from the admin) ───────────────────
# "vercel-blob" in production (the deployment filesystem is read-only), "local" in development.
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# ── Web Push (order updates, kitchen and rider alerts) ──────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ordini@dimsum.it

# ── Optional: Upstash Redis for rate limiting (PostgreSQL is used otherwise) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Security ────────────────────────────────────────────────────────────────
# Bearer token expected by /api/cron/* (Vercel Cron sends it automatically).
CRON_SECRET=
# Salt for one-way hashes of IP addresses (16+ random characters, required in production).
HASH_SALT=

# ── Native apps (deep links: /.well-known/apple-app-site-association, assetlinks.json) ─
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 fingerprints of the Android signing certificates.
ANDROID_SHA256_CERT_FINGERPRINTS=

# ── Local development: bootstrap accounts created by `npm run db:seed` ───────
# Use your own values; passwords need at least 10 characters. Leave empty in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_NAME=
SEED_RIDER_EMAIL=
SEED_RIDER_PASSWORD=
SEED_RIDER_NAME=
